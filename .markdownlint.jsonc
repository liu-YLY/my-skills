{
  // markdownlint 配置 —— 严格遵循项目硬约束「禁止对原有代码进行任何格式化操作」。
  //
  // 存量文档普遍采用对齐表格、紧凑列表等既定排版风格，全量修复会大规模改写
  // 既有文件，违反上述硬约束。因此这里仅禁用「被现有文档一致性违反的纯排版/
  // 风格类规则」，使 CI 能在不改写任何文档的前提下干净通过；其余 markdownlint
  // 默认规则保持启用，作为未来新增内容的真实门禁（对应 ci.yml 去掉 `|| true`）。
  //
  // 禁用清单基于全仓实测告警（共 3470 处，均为排版/风格类）：
  "default": true,

  // 行长（正文含大量长中文段落与链接，不做硬折行）
  "MD013": false,
  // 允许重复标题（多个 skill 文档复用「安装」「结构」等小节标题）
  "MD024": false,
  // 允许内联 HTML（徽章、details、对齐用 <br> 等）
  "MD033": false,
  // 首行非一级标题（部分文档以 frontmatter / 引用块起始）
  "MD041": false,

  // 表格管道内边距对齐 —— 存量占比最大（2475 处），属刻意的对齐排版
  "MD060": false,
  // 列表前后空行
  "MD032": false,
  // 代码块前后空行
  "MD031": false,
  // 标题前后空行
  "MD022": false,
  // 表格前后空行
  "MD058": false,
  // 引用块内空行
  "MD028": false,
  // 多个连续空行
  "MD012": false,
  // 有序列表序号风格
  "MD029": false,

  // 代码块缺少语言标注（244 处，多为纯文本示例块）
  "MD040": false,
  // 以强调代替标题（小节内的加粗小标题风格）
  "MD036": false,
  // 裸 URL（示例与参考链接）
  "MD034": false,
  // 硬 Tab（个别遗留文档）
  "MD010": false,
  // 标题层级递增（历史文档个别跳级）
  "MD001": false,
  // 表格列数一致性（个别示例表）
  "MD056": false
}
