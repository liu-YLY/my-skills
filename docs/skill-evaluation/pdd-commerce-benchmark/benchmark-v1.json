  "must_cover": [
    {
      "id": "MC-AUTH-01",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-01"],
      "dimension": "边界",
      "priority": "high",
      "criterion": "非 11 位、非 1[3-9] 开头、含非数字字符的手机号不发送验证码，并提示格式错误。"
    },
    {
      "id": "MC-AUTH-02",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-02"],
      "dimension": "边界",
      "priority": "high",
      "criterion": "验证码为 6 位数字，有效期 5 分钟，过期后校验失败。"
    },
    {
      "id": "MC-AUTH-03",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-02", "BR-AUTH-17"],
      "dimension": "异常",
      "priority": "high",
      "criterion": "同一手机号 60 秒内重复获取被拒绝；手机号、设备、IP 的每日发送上限生效；短信通道失败不计入次数。"
    },
    {
      "id": "MC-AUTH-04",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-03"],
      "dimension": "安全",
      "priority": "high",
      "criterion": "同一验证码最多校验 5 次，第 5 次失败后当前验证码失效，必须重新获取。"
    },
    {
      "id": "MC-AUTH-05",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-05"],
      "dimension": "功能",
      "priority": "high",
      "criterion": "未注册手机号验证码登录自动创建账号；已注册手机号直接登录；重复登录不产生重复账号。"
    },
    {
      "id": "MC-AUTH-06",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-06"],
      "dimension": "功能",
      "priority": "high",
      "criterion": "未勾选用户协议或隐私政策时无法登录/注册；勾选后可正常继续。"
    },
    {
      "id": "MC-AUTH-07",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-07"],
      "dimension": "边界",
      "priority": "high",
      "criterion": "密码 8-20 位且至少含字母和数字；纯数字、纯字母、与手机号相同、连续 6 位以上数字均被拒绝。"
    },
    {
      "id": "MC-AUTH-08",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-08"],
      "dimension": "安全",
      "priority": "critical",
      "criterion": "密码连续错误 5 次锁定 15 分钟；第 3 次失败起要求图形验证码；锁定期间正确密码也拒绝；提示不区分账号是否存在。"
    },
    {
      "id": "MC-AUTH-09",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-09"],
      "dimension": "权限",
      "priority": "high",
      "criterion": "微信登录未绑定手机号时必须先绑定；同一 unionid 只能绑定一个账号；同一手机号只能绑定一个微信账号。"
    },
    {
      "id": "MC-AUTH-10",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-10"],
      "dimension": "状态",
      "priority": "critical",
      "criterion": "登出后当前设备访问令牌和刷新令牌立即失效；其他设备登录态不受影响。"
    },
    {
      "id": "MC-AUTH-11",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-12"],
      "dimension": "状态",
      "priority": "critical",
      "criterion": "重置密码成功后，该账号所有设备会话失效，旧密码不可登录。"
    },
    {
      "id": "MC-AUTH-12",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-11"],
      "dimension": "状态",
      "priority": "high",
      "criterion": "同一账号最多 5 台设备在线；第 6 台登录踢出最早登录设备；被踢设备请求返回会话失效。"
    },
    {
      "id": "MC-AUTH-13",
      "module": "AUTH",
      "requirement_ids": ["BR-AUTH-14", "BR-AUTH-15"],
      "dimension": "安全",
