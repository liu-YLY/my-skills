{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "entities", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "purpose": {"enum": ["example", "test", "preview"]},
    "default_source_ids": {"$ref": "#/$defs/ids"},
    "generation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["strict", "preview"]},
        "seed": {"type": "integer"},
        "reference_datetime": {"type": "string", "format": "date-time"},
        "output_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["json", "jsonl", "csv"]}},
        "limits": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "max_total_rows": {"type": "integer", "minimum": 1},
            "max_output_bytes": {"type": "integer", "minimum": 1},
            "max_validation_rows": {"type": "integer", "minimum": 1, "maximum": 100000000},
            "max_relation_candidates": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
          }
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kind", "reference"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["requirement", "schema", "code", "user", "sample", "example"]},
          "reference": {"type": "string", "minLength": 1},
          "version": {"type": "string"}
        }
      }
    },
    "entities": {
      "type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["count", "primary_key", "fields"],
        "properties": {
          "count": {"type": "integer", "minimum": 0},
          "primary_key": {"$ref": "#/$defs/ids"},
          "unique_keys": {"type": "array", "items": {"$ref": "#/$defs/ids"}},
          "source_ids": {"$ref": "#/$defs/ids"},
          "confirmation": {"$ref": "#/$defs/confirmation"},
          "fields": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/field"}}
        }
      }
    },
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}},
    "negative_scenarios": {"type": "array", "items": {"$ref": "#/$defs/negative"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "check_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"}},
    "confirmation": {"enum": ["confirmed", "candidate", "pending-confirmation", "conflict"]},
    "scalar": {"type": ["string", "integer", "boolean", "null"]},
    "generator": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "constant"}, "value": {"$ref": "#/$defs/scalar"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "width"], "properties": {"kind": {"const": "sequence"}, "prefix": {"type": "string"}, "start": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1, "maximum": 18}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "choice"}, "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scalar"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["integer", "decimal"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "min_offset_seconds", "max_offset_seconds"], "properties": {"kind": {"const": "datetime_window"}, "min_offset_seconds": {"type": "integer"}, "max_offset_seconds": {"type": "integer"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "field", "min_seconds", "max_seconds"], "properties": {"kind": {"const": "relative_datetime"}, "field": {"$ref": "#/$defs/id"}, "min_seconds": {"type": "integer"}, "max_seconds": {"type": "integer"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "relation"], "properties": {"kind": {"const": "reference"}, "relation": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "provider", "locale"], "properties": {
          "kind": {"const": "faker"}, "provider": {"enum": ["name", "first_name", "last_name", "city", "street_address", "company", "email", "phone_number", "uuid4"]},
          "locale": {"type": "string", "pattern": "^[a-z]{2,3}_[A-Z]{2}$"}
        }},
        {"type": "object", "additionalProperties": false, "required": ["kind", "point"], "properties": {
          "kind": {"const": "boundary"}, "point": {"enum": ["min", "max", "min_length", "max_length", "empty", "null"]},
          "fill": {"type": "string", "minLength": 1, "maxLength": 1}
        }}
      ]
    },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "integer", "decimal", "boolean", "datetime"]},
        "nullable": {"type": "boolean"}, "unique": {"type": "boolean"},
        "min": {"type": ["integer", "string"]}, "max": {"type": ["integer", "string"]},
        "scale": {"type": "integer", "minimum": 0, "maximum": 18},
        "min_length": {"type": "integer", "minimum": 0}, "max_length": {"type": "integer", "minimum": 0, "maximum": 10000},
        "pattern": {"type": "string", "maxLength": 512},
        "enum": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scalar"}},
        "generator": {"$ref": "#/$defs/generator"},
        "source_ids": {"$ref": "#/$defs/ids"}, "confirmation": {"$ref": "#/$defs/confirmation"}
      }
    },
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["entity", "fields"], "properties": {"entity": {"$ref": "#/$defs/id"}, "fields": {"$ref": "#/$defs/ids"}}},
    "relation": {
      "type": "object", "additionalProperties": false, "required": ["id", "child", "parent"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "child": {"$ref": "#/$defs/endpoint"}, "parent": {"$ref": "#/$defs/endpoint"},
        "min_children": {"type": "integer", "minimum": 0}, "max_children": {"type": ["integer", "null"], "minimum": 0},
        "confirmation": {"$ref": "#/$defs/confirmation"}, "source_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "predicate": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["field", "op"], "properties": {"field": {"$ref": "#/$defs/id"}, "op": {"enum": ["is_null", "not_null"]}}},
        {"type": "object", "additionalProperties": false, "required": ["field", "op"], "oneOf": [{"required": ["value"]}, {"required": ["other_field"]}], "properties": {"field": {"$ref": "#/$defs/id"}, "op": {"enum": ["eq", "gte", "lte"]}, "value": {"$ref": "#/$defs/scalar"}, "other_field": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["field", "op", "value"], "properties": {"field": {"$ref": "#/$defs/id"}, "op": {"const": "in"}, "value": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}}}},
        {"type": "object", "additionalProperties": false, "required": ["field", "op", "other_field", "min_seconds", "max_seconds"], "properties": {
          "field": {"$ref": "#/$defs/id"}, "op": {"const": "time_delta"}, "other_field": {"$ref": "#/$defs/id"},
          "min_seconds": {"type": "integer"}, "max_seconds": {"type": "integer"}
        }}
      ]
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["id", "entity", "assert"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "entity": {"$ref": "#/$defs/id"}, "when": {"$ref": "#/$defs/predicate"}, "assert": {"$ref": "#/$defs/predicate"}, "confirmation": {"$ref": "#/$defs/confirmation"}, "source_ids": {"$ref": "#/$defs/ids"}}
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["id", "entity", "count", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "entity": {"$ref": "#/$defs/id"}, "count": {"type": "integer", "minimum": 1}, "kind": {"enum": ["normal", "boundary"]},
        "set": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scalar"}},
        "generators": {"type": "object", "additionalProperties": {"$ref": "#/$defs/generator"}},
        "case_ids": {"$ref": "#/$defs/ids"}, "combination_id": {"$ref": "#/$defs/id"},
        "target_check_ids": {"$ref": "#/$defs/check_ids"}, "description": {"type": "string", "maxLength": 512},
        "confirmation": {"$ref": "#/$defs/confirmation"}, "source_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "mutation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "field", "value"], "properties": {"op": {"const": "set"}, "field": {"$ref": "#/$defs/id"}, "value": {"$ref": "#/$defs/scalar"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "field"], "properties": {"op": {"const": "remove"}, "field": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "field", "point"], "properties": {
          "op": {"const": "boundary"}, "field": {"$ref": "#/$defs/id"}, "point": {"enum": ["below_min", "above_max", "too_short", "too_long"]},
          "fill": {"type": "string", "minLength": 1, "maxLength": 1}
        }}
      ]
    },
    "negative": {
      "type": "object", "additionalProperties": false, "required": ["id", "base_scenario", "count", "mutations", "expected_rule_violations"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "base_scenario": {"$ref": "#/$defs/id"}, "count": {"type": "integer", "minimum": 1},
        "mutations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mutation"}},
        "expected_rule_violations": {"$ref": "#/$defs/check_ids"},
        "confirmation": {"$ref": "#/$defs/confirmation"}, "source_ids": {"$ref": "#/$defs/ids"}
      }
    }
  }
}
