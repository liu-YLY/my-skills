{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_hash", "generation_status", "validation_status", "system_execution_status", "error_count", "errors", "errors_truncated", "violation_ids", "checks", "issues", "rule_summary"],
  "properties": {
    "schema_version": {"const": "1.0"}, "profile_id": {"type": "string"},
    "profile_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generation_status": {"enum": ["not_run", "complete", "partial", "blocked", "failed"]},
    "validation_status": {"enum": ["not_run", "passed", "failed", "incomplete"]},
    "system_execution_status": {"const": "not_run"},
    "error_count": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "object", "required": ["rule_id", "entity", "record_index", "field", "expected", "actual"]}},
    "errors_truncated": {"type": "boolean"}, "violation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "checks": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["evaluated", "applicable", "failed", "not_evaluable"], "properties": {
      "evaluated": {"type": "integer", "minimum": 0}, "applicable": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "not_evaluable": {"type": "integer", "minimum": 0}
    }}},
    "issues": {"type": "array", "items": {"type": "object"}},
    "rule_summary": {"type": "object", "additionalProperties": false, "required": ["declared", "implemented", "executed", "not_evaluable", "pending"], "properties": {
      "declared": {"type": "integer", "minimum": 0}, "implemented": {"type": "integer", "minimum": 0}, "executed": {"type": "integer", "minimum": 0}, "not_evaluable": {"type": "integer", "minimum": 0}, "pending": {"type": "integer", "minimum": 0}
    }},
    "integrity_issues": {"type": "array", "items": {"type": "string"}},
    "unexecuted_checks": {"type": "array", "items": {"type": "string"}},
    "incomplete_checks": {"type": "array", "items": {"type": "string"}},
    "negative_summary": {"type": "object", "additionalProperties": false, "required": ["validation_status", "expected_cases", "completed_cases", "mismatches", "issues", "cases"], "properties": {
      "validation_status": {"enum": ["passed", "failed", "not_run"]}, "expected_cases": {"type": "integer", "minimum": 0}, "completed_cases": {"type": "integer", "minimum": 0}, "mismatches": {"type": "integer", "minimum": 0}, "issues": {"type": "array", "items": {"type": "string"}}, "cases": {"type": "array", "items": {"type": "object"}}
    }}
  }
}
